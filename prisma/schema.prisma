// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Admin
  User
}

enum AuthType {
  Api
  Sms
  Email
}

enum TransactionStatus {
  PENDING // member submitted, waiting for admin
  CONFIRMED // admin verified the money landed
  REJECTED // admin couldn't verify it
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
  FINE_PAYMENT
  DUES
}

enum TransactionSource {
  Admin
  User
}

enum NotificationType {
  Deposit_Approved
  Deposit_Rejected
  Deposit
  Dues
  Fine
  General
}

enum ChargeReason {
  MISSED_MEETING
  LATE_DUES
  OTHER
}

enum ChargeStatus {
  Active
  Waived
}

enum AttendanceStatus {
  Present
  Absent
  Excused
}

enum FeedbackCategory {
  General
  Bug
  Suggestion
}

model Users {
  id                           Int       @id @default(autoincrement())
  firstName                    String
  middleName                   String?
  lastName                     String
  fullName                     String?
  email                        String    @unique
  phoneNo                      String    @unique
  dob                          DateTime?
  occupation                   String?
  nextOfKinName                String?
  nextOfKinRelationship        String?
  nextOfKinPhone               String?
  emergencyContact             String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  address                      String?
  password                     String
  state                        String?
  lga                          String?
  gender                       String?
  passport                     String?
  role                         UserRole  @default(User)
  isAdmin                      Boolean   @default(false)
  isDeleted                    Boolean   @default(false)
  isActive                     Boolean   @default(true)
  created                      DateTime  @default(now())
  updated                      DateTime  @updatedAt

  userSessions          UserSessions[]
  reviewedTransactions  PaymentTransactions[] @relation("reviewer")
  depositedTransactions PaymentTransactions[] @relation("depositor")
  notifications         Notifications[]
  feedbacks             Feedbacks[]
  attendance            Attendance[]
  charges               Charges[]
  dues                  DueTypes[]
}

model UserSessions {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String?
  resetToken   String?
  smsToken     String?
  expiration   DateTime
  role         UserRole
  authType     AuthType @default(Api)
  created      DateTime @default(now())
  updated      DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankAcconts {
  id            Int      @id @default(autoincrement())
  bankName      String
  accountName   String
  accountNumber String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  transactions PaymentTransactions[]
}

model PaymentTransactions {
  id            Int               @id @default(autoincrement())
  bankAccountId Int
  chargeId      Int?
  duesTypeId    Int?
  userId        Int
  status        TransactionStatus @default(PENDING)
  type          TransactionType   @default(DEPOSIT)
  amount        BigInt
  currency      String            @default("NGN")
  note          String?
  source        TransactionSource
  attachmentUrl String?
  reviewedById  Int?
  period        DateTime
  depositedAt   DateTime?
  reviewedAt    DateTime?
  created       DateTime          @default(now())
  updated       DateTime          @updatedAt

  depositedBy Users       @relation("depositor", fields: [userId], references: [id], onDelete: SetDefault)
  reviewedBy  Users?      @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetDefault)
  charge      Charges?    @relation(fields: [chargeId], references: [id], onDelete: SetDefault)
  dues        DueTypes?   @relation(fields: [duesTypeId], references: [id], onDelete: SetNull)
  bankAccount BankAcconts @relation(fields: [bankAccountId], references: [id], onDelete: SetDefault)
}

model Notifications {
  id      Int              @id @default(autoincrement())
  userId  Int
  type    NotificationType
  title   String
  body    String
  link    String? // e.g. "/transactions/abc", so the UI can deep-link
  readAt  DateTime?
  created DateTime         @default(now())
  user    Users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, created])
}

model Feedbacks {
  id          Int              @id @default(autoincrement())
  userId      Int
  subject     String?
  message     String
  category    FeedbackCategory
  // status      FeedbackStatus @default(NEW)
  response    String?
  respondedBy String?
  responded   DateTime?
  created     DateTime         @default(now())
  updated     DateTime         @updatedAt
  member      Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      FeedbackImages[]

  @@index([userId])
}

model FeedbackImages {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  imageUrl   String
  caption    String?
  created    DateTime @default(now())

  feedback Feedbacks @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Charges {
  id          Int          @id @default(autoincrement())
  userId      Int
  reason      ChargeReason
  status      ChargeStatus @default(Active)
  amount      BigInt
  description String?
  period      DateTime?    @db.Date // for LATE_DUES: which month
  meetingId   Int? // for MISSED_MEETING
  issuedBy    Int
  waivedBy    String?
  waivedAt    DateTime?
  created     DateTime     @default(now())
  updated     DateTime     @updatedAt
  meeting     Meetings?    @relation(fields: [meetingId], references: [id])
  users       Users        @relation(fields: [userId], references: [id])

  payments PaymentTransactions[]

  @@unique([userId, reason, meetingId]) // one fine per member per meeting
  @@unique([userId, reason, period]) // one late fee per member per month
  @@index([userId, status])
}

model Meetings {
  id           Int       @id @default(autoincrement())
  title        String
  meetingUrl   String
  heldAt       DateTime
  finializedAt DateTime?
  created      DateTime  @default(now())
  updated      DateTime  @updatedAt

  attendance Attendance[]
  charges    Charges[]
}

model Attendance {
  id        Int              @id @default(autoincrement())
  meetingId Int
  userId    Int
  status    AttendanceStatus
  joinedAt  DateTime?
  joinCount Int              @default(0)
  created   DateTime         @default(now())
  updated   DateTime         @updatedAt
  user      Users            @relation(fields: [userId], references: [id])
  meeting   Meetings         @relation(fields: [meetingId], references: [id])

  @@unique([meetingId, userId])
}

model DueTypes {
  id          Int       @id @default(autoincrement())
  createdById Int?
  name        String    @unique
  description String?
  amount      BigInt // now required, since this is what everyone owes
  dueDate     DateTime? // optional deadline, for showing "overdue"
  isActive    Boolean   @default(true)
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  createdBy Users? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  payments PaymentTransactions[]
}
